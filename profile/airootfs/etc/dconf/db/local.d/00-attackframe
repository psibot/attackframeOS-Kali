# AttackFrame OS — GNOME defaults (users can still change everything)

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='AttackFrame-Neon'
accent-color='teal'
monospace-font-name='JetBrainsMono Nerd Font 11'
document-font-name='JetBrainsMono Nerd Font 11'
clock-show-seconds=true
clock-show-weekday=true
enable-hot-corners=false
show-battery-percentage=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/attackframe/af-kali-blue-horizon.png'
picture-uri-dark='file:///usr/share/backgrounds/attackframe/af-kali-blue-horizon.png'
picture-options='zoom'
primary-color='#05070d'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/attackframe/af-kali-rolling-hud.png'
primary-color='#05070d'

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='JetBrainsMono Nerd Font Bold 10'
num-workspaces=4

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=false

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true

[org/gnome/shell]
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'appindicatorsupport@rgcjonas.gmail.com', 'ubuntu-appindicators@ubuntu.com', 'attackframe-hud@attackframe']
favorite-apps=['org.gnome.Terminal.desktop', 'attackframe-arsenal.desktop', 'firefox.desktop', 'af-burpsuite.desktop', 'af-wireshark.desktop', 'af-ghidra.desktop', 'org.gnome.Nautilus.desktop']

[org/gnome/shell/extensions/user-theme]
name='AttackFrame'

[org/gnome/desktop/app-folders]
